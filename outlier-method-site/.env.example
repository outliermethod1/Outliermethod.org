# Anthropic Claude API — chat generation
ANTHROPIC_API_KEY=

# Voyage AI — embeddings for the bylaw vector index (Anthropic's recommended
# embedding partner; Claude itself has no embeddings endpoint). Without this,
# retrieval falls back to keyword-only search on bylaw_id and title/body.
VOYAGE_API_KEY=

# Postgres with pgvector — Neon via the Vercel integration
# Neon connection string, e.g. postgres://user:pass@host/dbname?sslmode=require
DATABASE_URL=

# Vercel Blob — stores source bylaw PDFs (bylaws/{state}/{date}-{slug}.pdf)
BLOB_READ_WRITE_TOKEN=

# Admin panel — single shared password, no user accounts
ADMIN_PASSWORD=

# Secret used to sign the admin session cookie AND beta-tester user session
# cookies (lib/user-auth.ts) — one secret, two independent session systems.
ADMIN_SESSION_SECRET=

# Resend — transactional email for beta-tester signup verification and the
# admin new-signup notification. Without this set, emails are logged to the
# server console instead of sent (signup still works, but users won't get a
# real verification link). Sending to arbitrary recipients (not just your own
# Resend account email) requires verifying a sending domain in the Resend
# dashboard — until then, verification emails to real testers won't deliver.
RESEND_API_KEY=

# Optional — defaults to "AD Chief of Staff <onboarding@resend.dev>"
EMAIL_FROM=

# Optional — where new-signup notifications go. Defaults to outliermethod1@gmail.com
ADMIN_NOTIFY_EMAIL=

# Optional — protects the Vercel Cron crawler endpoint from being hit externally
# Vercel sets this automatically for Cron-triggered requests when configured
CRON_SECRET=

# ElevenLabs — text-to-speech for the "Voice" toggle in /profile (off by
# default per user, gated as a future-premium feature). Without this set,
# /api/tts returns an error and voice playback silently stays unavailable —
# nothing else in the app is affected.
ELEVENLABS_API_KEY=

# Optional — which ElevenLabs voice reads Eli's answers. Defaults to "Adam"
# (pNInz6obpgDQGcFmaJgB). Browse voices and copy an ID from elevenlabs.io.
ELEVENLABS_VOICE_ID=
